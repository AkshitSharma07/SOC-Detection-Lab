alert tcp any any -> $HOME_NET any (msg:"Local Recon - possible TCP SYN Port scan"; flow:to_server; flags:S; threshold:type both, track by_src, count 30, seconds 5; classtype:attempted-recon; sid:10001; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"Local Brute force-repeated SSH connection attempts"; flow:to_server; flags:S; threshold:type both, track by_src, count 4, seconds 30; classtype:attempted-admin; sid:10002; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"Local DoS - possible SYN flood"; flow:to_server; flags:S; threshold:type both, track by_dst, count 300, seconds 2; classtype:attempted-dos; sid:10003; rev:1;)
alert http any any -> $HOME_NET any (msg:"Local Dos - possible HTTP request flood"; flow:established,to_server; http.method; content:"GET"; threshold:type both, track by_src, count 100, seconds 5; classtype:attempted-dos; sid:10004; rev:1;)
